# Slack incoming webhooks, one per channel. Not read by Docker Compose (gluetun
# loads .env, so webhooks stay out of it). On the server: chmod 600. Never commit
# real URLs. An empty value means "log only" for that channel.
SLACK_WEBHOOK_SONARR_ALERTS=<SLACK_WEBHOOK_URL>        # #sonarr-alerts    (sonarr_watchdog.py)
SLACK_WEBHOOK_SERVER_HEALTH=<SLACK_WEBHOOK_URL>        # #server-health    (slack_reports.py health, digest)
SLACK_WEBHOOK_USAGE_STATS=<SLACK_WEBHOOK_URL>          # #usage-stats      (slack_reports.py usage)
SLACK_WEBHOOK_WEEKLY_DOWNLOADS=<SLACK_WEBHOOK_URL>     # #weekly-downloads (slack_reports.py weekly)
